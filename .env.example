# Firebase (Web / JS SDK) — from Firebase console → Project settings → General → Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In: Firebase console → Project settings → General → your Android/iOS app
# Or Google Cloud → APIs → Credentials (OAuth 2.0 client IDs) → Web client
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: Expo project id for push tokens (EAS) — expo.dev → project
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional (recommended): HTTPS origin for clickable invite links
# Recommended setup: invite-only subdomain (Netlify site #2) + main web app site
# Example: https://get.istantapp.it
EXPO_PUBLIC_APP_ORIGIN=
