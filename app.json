{
  "expo": {
    "name": "Istant",
    "slug": "istant",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "istant",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.istant.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "appleTeamId": "PX49GHL64Y",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.istant",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Istant to use the camera to capture your moments."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [],
          "icon": "./assets/icon.png"
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.560081968430-d16lrk3vccol432eglj07ioka3plr803"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63eaad4d-507c-4306-b735-66117de666ff"
      }
    }
  }
}
