rules_version = '2';
// Dev rules for admin.html: VERY permissive for posts.
// WARNING: This makes posts (and reactions/views) readable & deletable without auth.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function postDoc(postId) {
      return get(/databases/$(database)/documents/posts/$(postId));
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSelf(uid);
    }

    match /friendships/{id} {
      // Allow `get()` to check existence before creating.
      // If the doc doesn't exist, reading it reveals nothing, but unblocks client logic.
      allow get: if isSignedIn()
        && (!exists(/databases/$(database)/documents/friendships/$(id))
          || request.auth.uid in resource.data.users);
      allow list: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.users;
      allow update, delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // Shareable friend invite links: friendInvites/{token}
    // Token is random; invite can be redeemed client-side by reading it then sending a friend request.
    match /friendInvites/{token} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt is string;
      // Allow deletion by the owner (optional cleanup)
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    match /users/{uid}/closeFriends/{f} {
      allow read, write: if isSelf(uid);
    }

    match /posts/{postId} {
      // Admin page needs to list all posts without auth.
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      // Admin page needs to delete posts without auth.
      allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid;
      allow delete: if true;
    }

    match /posts/{postId}/reactions/{rid} {
      // Admin page needs to delete reactions without auth during post cleanup.
      allow read: if true;
      allow create, update: if isSelf(rid)
        || (isSignedIn() && request.auth.uid == postDoc(postId).data.authorUid);
      allow delete: if true;
    }

    match /posts/{postId}/views/{vid} {
      // Admin page needs to delete views without auth during post cleanup.
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.auth.uid == vid
        && request.auth.uid in postDoc(postId).data.audienceUids;
      allow delete: if true;
    }

    match /istantMoments/{momentId} {
      // Created and managed server-side (Cloud Functions). Clients can only read if included.
      allow read: if isSignedIn() && request.auth.uid in resource.data.audienceUids;
      allow create, update, delete: if false;
    }

    // Abuse reports (write-only for users; readable only by the reporter for now)
    match /reports/{rid} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
    }
  }
}
